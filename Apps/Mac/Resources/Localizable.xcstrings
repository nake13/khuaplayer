    "privacy.summary.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App verwendet keine Analysen und überträgt keine Wiedergabedaten. Der Wiedergabeverlauf wird nur auf diesem Mac gespeichert und kann über das App-Menü gelöscht werden. Konfigurierte Direktdownload-Versionen können den Aktualisierungsdienst kontaktieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app does not use analytics or transmit playback data. Playback history is stored only on this Mac and can be cleared from the app menu. Configured direct-download builds may contact the update service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app no usa analíticas ni transmite datos de reproducción. El historial de reproducción se guarda solo en este Mac y puede borrarse desde el menú de la app. Las versiones configuradas para descarga directa pueden contactar con el servicio de actualizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app n’utilise aucun outil d’analyse et ne transmet aucune donnée de lecture. L’historique de lecture reste sur ce Mac et peut être effacé depuis le menu de l’app. Les versions configurées pour le téléchargement direct peuvent contacter le service de mise à jour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini tidak menggunakan analitik atau mengirimkan data pemutaran. Riwayat pemutaran hanya disimpan di Mac ini dan dapat dihapus dari menu aplikasi. Versi unduhan langsung yang dikonfigurasi dapat menghubungi layanan pembaruan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app non usa strumenti di analisi e non trasmette dati di riproduzione. La cronologia di riproduzione resta solo su questo Mac e può essere cancellata dal menu dell’app. Le versioni configurate per il download diretto possono contattare il servizio di aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは解析機能を使用せず、再生データを送信しません。再生履歴はこの Mac にのみ保存され、アプリのメニューから消去できます。設定済みの直接配布版はアップデートサービスに接続する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 분석 기능을 사용하거나 재생 데이터를 전송하지 않습니다. 재생 기록은 이 Mac에만 저장되며 앱 메뉴에서 지울 수 있습니다. 업데이트가 설정된 직접 다운로드 버전은 업데이트 서비스에 연결할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze app gebruikt geen analyses en verstuurt geen afspeelgegevens. De afspeelgeschiedenis wordt alleen op deze Mac bewaard en kan via het appmenu worden gewist. Geconfigureerde direct-downloadversies kunnen contact opnemen met de updateservice."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja nie używa analityki ani nie przesyła danych o odtwarzaniu. Historia odtwarzania jest przechowywana tylko na tym Macu i można ją wyczyścić z menu aplikacji. Skonfigurowane wersje pobierane bezpośrednio mogą łączyć się z usługą aktualizacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app não usa análises nem transmite dados de reprodução. O histórico de reprodução fica armazenado apenas neste Mac e pode ser apagado no menu do app. Versões configuradas para download direto podem contatar o serviço de atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не использует аналитику и не передаёт данные о воспроизведении. История воспроизведения хранится только на этом Mac и может быть очищена из меню приложения. Настроенные версии для прямой загрузки могут обращаться к службе обновлений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปนี้ไม่ใช้ระบบวิเคราะห์หรือส่งข้อมูลการเล่น ประวัติการเล่นจะเก็บไว้บน Mac เครื่องนี้เท่านั้นและสามารถล้างได้จากเมนูของแอป รุ่นดาวน์โหลดโดยตรงที่ตั้งค่าไว้สามารถติดต่อบริการอัปเดตได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama analiz kullanmaz veya oynatma verilerini iletmez. Oynatma geçmişi yalnızca bu Mac’te saklanır ve uygulama menüsünden silinebilir. Yapılandırılmış doğrudan indirme sürümleri güncelleme hizmetine bağlanabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng này không dùng công cụ phân tích hoặc truyền dữ liệu phát. Lịch sử phát chỉ được lưu trên máy Mac này và có thể xóa từ menu ứng dụng. Bản tải xuống trực tiếp đã cấu hình có thể liên hệ dịch vụ cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用不使用分析服务，也不会传输播放数据。播放历史仅存储在这台 Mac 上，并可从应用菜单中清除。已配置更新功能的直接下载版可能会连接更新服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 不使用分析服務，也不會傳輸播放資料。播放記錄僅儲存於這部 Mac，並可從 App 選單中清除。已設定更新功能的直接下載版可能會連線至更新服務。"
          }
        }
      }
    },
