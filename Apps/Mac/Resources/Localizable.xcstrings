    "error.doviMetadataUnsupported": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dolby Vision-Datei verwendet ein nicht unterstütztes Metadatenformat und hat keine kompatible Basisschicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Dolby Vision file requires an unsupported metadata format and has no compatible base layer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo Dolby Vision usa un formato de metadatos no compatible y no tiene una capa base compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier Dolby Vision utilise un format de métadonnées non pris en charge et ne possède aucune couche de base compatible."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File Dolby Vision ini menggunakan format metadata yang belum didukung dan tidak memiliki lapisan dasar yang kompatibel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file Dolby Vision usa un formato di metadati non supportato e non dispone di un livello base compatibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このDolby Visionファイルは未対応のメタデータ形式を使用しており、互換性のあるベースレイヤーもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Dolby Vision 파일은 지원되지 않는 메타데이터 형식을 사용하며 호환되는 기본 레이어가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit Dolby Vision-bestand gebruikt een niet-ondersteunde metadata-indeling en heeft geen compatibele basislaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik Dolby Vision używa nieobsługiwanego formatu metadanych i nie ma zgodnej warstwy bazowej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro Dolby Vision utiliza um formato de metadados não suportado e não tem uma camada base compatível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл Dolby Vision использует неподдерживаемый формат метаданных и не содержит совместимого базового слоя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ Dolby Vision นี้ใช้รูปแบบข้อมูลเมตาที่ยังไม่รองรับ และไม่มีเลเยอร์พื้นฐานที่เข้ากันได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Dolby Vision dosyası desteklenmeyen bir meta veri biçimi kullanıyor ve uyumlu bir temel katmanı yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp Dolby Vision này sử dụng định dạng siêu dữ liệu chưa được hỗ trợ và không có lớp cơ sở tương thích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Dolby Vision 文件使用了暂不支持的元数据格式，且没有可兼容播放的基础层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Dolby Vision 檔案使用尚未支援的中繼資料格式，且沒有相容的基礎層可供播放。"
          }
        }
      }
    },
