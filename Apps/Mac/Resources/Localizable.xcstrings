    "chrome.volume.boost.prompt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke erneut ↑ oder ziehe nach rechts, um die Lautstärke zu verstärken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ↑ or drag right again to boost volume"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ↑ o arrastra de nuevo hacia la derecha para amplificar el volumen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez de nouveau sur ↑ ou faites glisser vers la droite pour amplifier le volume"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan ↑ atau seret ke kanan sekali lagi untuk memperkuat volume"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi di nuovo ↑ o trascina verso destra per amplificare il volume"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度 ↑ を押すか右へドラッグすると音量をブーストできます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음량을 증폭하려면 ↑ 키를 다시 누르거나 오른쪽으로 드래그하십시오"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk nogmaals op ↑ of sleep naar rechts om het volume te versterken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij ponownie ↑ lub przeciągnij w prawo, aby wzmocnić głośność"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ↑ novamente ou arraste de novo para a direita para amplificar o volume"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ↑ ещё раз или снова перетащите вправо, чтобы усилить громкость"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด ↑ หรือลากไปทางขวาอีกครั้งเพื่อขยายระดับเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi yükseltmek için ↑ tuşuna yeniden basın veya tekrar sağa sürükleyin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn lại ↑ hoặc kéo sang phải để khuếch đại âm lượng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再按 ↑ 或向右拖动，可增强音量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再按一次 ↑ 或向右拖移，即可增強音量"
          }
        }
      }
    },
