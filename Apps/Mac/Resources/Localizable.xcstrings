        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download sembra interrotto. L’indice di questo video si trova alla fine del file; la riproduzione partirà automaticamente una volta scaricato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードが止まっているようです。この動画のインデックスはファイルの末尾にあり、ダウンロードされると自動的に再生が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
