    "captions.dialog.jumpAhead": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorherigen stoppen: Dieses Video startet sofort, die bisher erstellten Untertitel des vorherigen werden verworfen.\nAbwarten: Dieses Video startet automatisch, sobald das vorherige fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop previous: this video starts now, and what the previous one generated is discarded.\nWait: this video starts automatically when it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener el anterior: este vídeo empieza ahora y se descarta lo generado del anterior.\nEsperar: este vídeo empieza automáticamente cuando el anterior termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter le précédent : cette vidéo démarre tout de suite et les sous-titres déjà générés pour la précédente sont perdus.\nAttendre : cette vidéo démarre automatiquement une fois la précédente terminée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan yang sebelumnya: video ini langsung dimulai, hasil subtitle video sebelumnya dibuang.\nTunggu: video ini otomatis dimulai setelah yang sebelumnya selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi il precedente: questo video inizia subito e i sottotitoli già generati per il precedente vengono eliminati.\nAttendi: questo video inizia automaticamente quando il precedente è completato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の動画を停止：この動画をすぐに開始し、前の動画で生成済みの内容は破棄されます。\n完了を待つ：前の動画が完了すると、この動画を自動的に開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 작업 중지: 이 영상을 바로 시작하고, 이전 영상에서 생성된 내용은 삭제됩니다.\n기다리기: 이전 영상이 완료되면 이 영상이 자동으로 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorige stoppen: deze video begint meteen, de al gegenereerde ondertitels van de vorige gaan verloren.\nWachten: deze video begint automatisch zodra de vorige klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj poprzedni: ten film zacznie się od razu, a napisy wygenerowane dotąd dla poprzedniego zostaną odrzucone.\nPoczekaj: ten film zacznie się automatycznie po ukończeniu poprzedniego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Interromper o anterior: este vídeo começa agora e o que foi gerado do anterior é descartado.\nAguardar: este vídeo começa automaticamente quando o anterior terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановить предыдущее: это видео начнётся сразу, а уже созданные субтитры предыдущего будут потеряны.\nДождаться: это видео начнётся автоматически после завершения предыдущего."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดวิดีโอก่อนหน้า: วิดีโอนี้จะเริ่มทันที และคำบรรยายที่สร้างไว้ของวิดีโอก่อนหน้าจะถูกทิ้ง\nรอให้เสร็จ: วิดีโอนี้จะเริ่มโดยอัตโนมัติเมื่อวิดีโอก่อนหน้าเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öncekini durdur: Bu video hemen başlar, önceki video için oluşturulan altyazılar silinir.\nBekle: Önceki video bitince bu video otomatik olarak başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng video trước: video này bắt đầu ngay, phụ đề đã tạo của video trước sẽ bị hủy.\nChờ: video này tự động bắt đầu khi video trước hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止上一部：这部马上开始，上一部已生成的内容丢弃。\n等它完成：这部自动开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止上一部：這部馬上開始，上一部已產生的內容會捨棄。\n等它完成：這部自動開始。"
          }
        }
      }
    },
