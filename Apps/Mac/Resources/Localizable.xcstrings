    "chrome.xdr.tooltip.on": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightness Boost ist aktiviert und erhöht die Bildhelligkeit entsprechend den Möglichkeiten des Displays"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightness Boost is on and increases picture brightness according to the display’s capabilities"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightness Boost está activado y aumenta el brillo de la imagen según las capacidades de la pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightness Boost est activé et augmente la luminosité de l’image selon les capacités de l’écran"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightness Boost aktif dan meningkatkan kecerahan gambar sesuai kemampuan layar"
          }
