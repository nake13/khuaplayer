            "value": "Il servizio di traduzione ha restituito risultati incompleti. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳サービスからの結果が不完全です。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역 서비스에서 불완전한 결과를 반환했습니다. 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vertaaldienst heeft onvolledige resultaten teruggegeven. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa tłumaczenia zwróciła niekompletne wyniki. Spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de tradução retornou resultados incompletos. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис перевода вернул неполные результаты. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการแปลภาษาส่งผลลัพธ์กลับมาไม่ครบถ้วน โปรดลองอีกครั้ง"
