    "memc.policy.resolutionLimit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Videoauflösung überschreitet die Interpolationsgrenze (lange Seite 4096, kurze Seite 2160)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video resolution exceeds the interpolation limit (long edge 4096, short edge 2160)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La resolución del vídeo supera el límite de interpolación (lado largo 4096, lado corto 2160)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La résolution vidéo dépasse la limite d’interpolation (côté long 4096, côté court 2160)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolusi video melebihi batas interpolasi (sisi panjang 4096, sisi pendek 2160)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risoluzione video supera il limite di interpolazione (lato lungo 4096, lato corto 2160)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の解像度がフレーム補間の上限を超えています（長辺 4096、短辺 2160）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상 해상도가 프레임 보간 한도를 초과합니다 (긴 변 4096, 짧은 변 2160)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De videoresolutie overschrijdt de interpolatielimiet (lange zijde 4096, korte zijde 2160)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdzielczość wideo przekracza limit interpolacji (dłuższy bok 4096, krótszy bok 2160)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A resolução do vídeo excede o limite de interpolação (lado maior 4096, lado menor 2160)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение видео превышает предел интерполяции (длинная сторона 4096, короткая сторона 2160)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความละเอียดวิดีโอเกินขีดจำกัดการแทรกเฟรม (ด้านยาว 4096 ด้านสั้น 2160)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video çözünürlüğü kare enterpolasyonu sınırını aşıyor (uzun kenar 4096, kısa kenar 2160)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ phân giải video vượt quá giới hạn nội suy khung hình (cạnh dài 4096, cạnh ngắn 2160)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频分辨率超过插帧上限（长边 4096，短边 2160）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片解析度超過補幀上限（長邊 4096，短邊 2160）"
          }
        }
      }
    },
