    "captions.output.nameTooLong": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dateiname ist zu lang. Den Videodateinamen kürzen oder die Untertitel unter einem anderen Namen speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The filename is too long. Shorten the video filename or save subtitles under another name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del archivo es demasiado largo. Acorta el nombre del vídeo o guarda los subtítulos con otro nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom du fichier est trop long. Raccourcissez le nom de la vidéo ou enregistrez les sous-titres sous un autre nom."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama file terlalu panjang. Persingkat nama file video atau simpan subtitle dengan nama lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome del file è troppo lungo. Accorcia il nome del video o salva i sottotitoli con un altro nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル名が長すぎます。動画のファイル名を短くするか、字幕を別の名前で保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 이름이 너무 깁니다. 비디오 파일 이름을 줄이거나 자막을 다른 이름으로 저장하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bestandsnaam is te lang. Kort de videobestandsnaam in of sla de ondertitels op onder een andere naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa pliku jest zbyt długa. Skróć nazwę pliku wideo lub zapisz napisy pod inną nazwą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome do arquivo é muito longo. Encurte o nome do vídeo ou salve as legendas com outro nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя файла слишком длинное. Сократите имя видеофайла или сохраните субтитры под другим именем."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อไฟล์ยาวเกินไป โปรดย่อชื่อไฟล์วิดีโอหรือบันทึกคำบรรยายด้วยชื่ออื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya adı çok uzun. Video dosyasının adını kısaltın veya altyazıları başka bir adla kaydedin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên tệp quá dài. Hãy rút ngắn tên tệp video hoặc lưu phụ đề bằng tên khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件名过长，请缩短视频文件名或另存到其他文件名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案名稱過長。請縮短影片檔名，或將字幕另存為其他名稱。"
          }
        }
      }
