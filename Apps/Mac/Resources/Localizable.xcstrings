    "memc.policy.chromaSiting": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chroma-Siting noch nicht verifiziert; ursprüngliche Bildrate wird beibehalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chroma siting not yet verified; original frame rate kept"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La posición del muestreo de croma aún no está verificada; se mantiene la frecuencia de fotogramas original"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Position d’échantillonnage chroma non encore vérifiée ; fréquence d’images d’origine conservée"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisi sampling kroma belum diverifikasi; laju bingkai asli dipertahankan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posizione del campionamento croma non ancora verificata; frequenza fotogrammi originale mantenuta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クロマサンプリング位置が未検証のため、元のフレームレートを維持しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크로마 샘플링 위치가 아직 검증되지 않아 원본 프레임 속도를 유지합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromapositie nog niet geverifieerd; oorspronkelijke beeldfrequentie behouden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Położenie próbkowania chrominancji nie zostało jeszcze zweryfikowane; zachowano oryginalną liczbę klatek"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Posicionamento de croma ainda não verificado; taxa de quadros original mantida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позиция отсчётов цветности ещё не подтверждена; сохранена исходная частота кадров"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตำแหน่งการสุ่มตัวอย่างโครมายังไม่ผ่านการตรวจสอบ จึงคงอัตราเฟรมเดิมไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renk örnekleme konumu henüz doğrulanmadı; orijinal kare hızı korundu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí lấy mẫu màu hiện tại chưa được xác minh, giữ nguyên tốc độ khung hình gốc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前色度采样位置尚未验证，已保留原始帧率"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前色度取樣位置尚未驗證，已保留原始影格率"
          }
        }
      }
    },
    "memc.policy.dynamicHDR": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dolby-Vision-Profil hat keine verifizierte kompatible Basisschicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Dolby Vision profile has no verified compatible base layer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil de Dolby Vision no tiene una capa base compatible verificada"
          }
        },
        "fr": {
          "stringUnit": {
