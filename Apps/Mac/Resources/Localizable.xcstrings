    "captions.quit.savingMessage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Untertitel für „%@“ werden gespeichert. Das Beenden kann den Speichervorgang unterbrechen. Zum Weiterwarten „Abbrechen“ wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitles for “%@” are being saved. Quitting may interrupt the save. Choose Cancel to keep waiting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se están guardando los subtítulos para «%@». Salir puede interrumpir el guardado. Elige Cancelar para seguir esperando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sous-titres pour « %@ » sont en cours d’enregistrement. Quitter peut interrompre l’enregistrement. Choisissez Annuler pour continuer à attendre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitle untuk “%@” sedang disimpan. Keluar dapat mengganggu penyimpanan. Pilih Batal untuk tetap menunggu."
