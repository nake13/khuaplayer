    "error.openFailed.indexAtTail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der für die Wiedergabe benötigte Index (moov) wurde nicht gefunden. Möglicherweise wird die Datei noch heruntergeladen oder ihre Struktur ist beschädigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The index (moov) needed for playback was not found. The file may still be downloading, or its structure may be damaged"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el índice (moov) necesario para la reproducción. Puede que el archivo aún se esté descargando o que su estructura esté dañada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’index (moov) nécessaire à la lecture est introuvable. Le fichier est peut-être encore en cours de téléchargement, ou sa structure peut être endommagée"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks (moov) yang diperlukan untuk pemutaran tidak ditemukan. File mungkin masih diunduh atau struktur file mungkin rusak"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indice (moov) necessario per la riproduzione non è stato trovato. Il download del file potrebbe essere ancora in corso oppure la sua struttura potrebbe essere danneggiata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生に必要なインデックス（moov）が見つかりません。ファイルがまだダウンロード中か、ファイル構造が破損している可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생에 필요한 인덱스(moov)를 찾을 수 없습니다. 파일이 아직 다운로드 중이거나 파일 구조가 손상되었을 수 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De index (moov) die nodig is voor het afspelen is niet gevonden. Het bestand wordt mogelijk nog gedownload of de bestandsstructuur kan beschadigd zijn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono indeksu (moov) potrzebnego do odtwarzania. Plik może być nadal pobierany lub jego struktura może być uszkodzona"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi encontrado o índice (moov) necessário para a reprodução. O arquivo pode ainda estar sendo baixado ou sua estrutura pode estar danificada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не найден индекс (moov), необходимый для воспроизведения. Возможно, файл ещё загружается или его структура повреждена"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบดัชนี (moov) ที่จำเป็นสำหรับการเล่น ไฟล์อาจยังอยู่ระหว่างการดาวน์โหลด หรือโครงสร้างไฟล์อาจเสียหาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatma için gereken dizin (moov) bulunamadı. Dosya hâlâ indiriliyor olabilir ya da dosya yapısı hasarlı olabilir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy chỉ mục (moov) cần thiết để phát. Tệp có thể vẫn đang được tải xuống hoặc cấu trúc tệp có thể đã hỏng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到播放所需的索引（moov）。文件可能仍在下载，也可能存在结构损坏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到播放所需的索引（moov）。檔案可能仍在下載，也可能存在結構損毀"
          }
        }
      }
    },
