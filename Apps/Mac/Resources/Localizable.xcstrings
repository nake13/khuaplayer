          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的 Dolby Vision 設定檔沒有已驗證的相容基礎層"
          }
        }
      }
    },
    "memc.policy.fastPlayback": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildinterpolation ist über 1× nicht verfügbar; sie wird bei 1× fortgesetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame interpolation is unavailable above 1× speed; it resumes at 1×"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La interpolación no está disponible por encima de 1×; se reanuda a 1×"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interpolation est indisponible au-delà de 1× ; elle reprend à 1×"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpolasi bingkai tidak tersedia di atas 1×; dilanjutkan pada 1×"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interpolazione non è disponibile oltre 1×; riprende a 1×"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1×を超える速度ではフレーム補間を利用できません。1×に戻すと再開します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1×를 초과하는 속도에서는 프레임 보간을 사용할 수 없습니다. 1×로 돌아오면 재개됩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame-interpolatie is niet beschikbaar boven 1×; deze wordt hervat bij 1×"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpolacja klatek jest niedostępna powyżej 1×; zostanie wznowiona przy 1×"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A interpolação de quadros não está disponível acima de 1×; ela é retomada a 1×"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Интерполяция кадров недоступна при скорости выше 1×; она возобновится при 1×"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแทรกเฟรมไม่พร้อมใช้งานที่ความเร็วเกิน 1× และจะกลับมาทำงานเมื่อใช้ความเร็ว 1×"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1× hızının üzerinde ara kare oluşturma kullanılamaz; 1× hızında devam eder"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội suy khung hình không khả dụng ở tốc độ trên 1×; sẽ tiếp tục khi trở về 1×"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放速度超过 1× 时不可插帧，回到 1× 后自动恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放速度超過 1× 時無法補幀，回到 1× 後自動恢復"
          }
        }
      }
    },
    "memc.policy.interlaced": {
      "localizations": {
        "de": {
