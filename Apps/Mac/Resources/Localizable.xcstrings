    "chrome.memc.tooltip.active": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost ist aktiviert und erzeugt Zwischenbilder für flüssigere Bewegungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost is on and generating intermediate frames for smoother motion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost está activado y genera fotogramas intermedios para lograr movimientos más fluidos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost est activé et génère des images intermédiaires pour des mouvements plus fluides"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost aktif dan sedang membuat bingkai antara agar gerakan lebih mulus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost è attivo e genera fotogrammi intermedi per movimenti più fluidi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boostはオンで、映像の動きを滑らかにするために中間フレームを生成しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost가 켜져 있으며 화면 움직임을 더 부드럽게 만들기 위해 중간 프레임을 생성하고 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost is ingeschakeld en genereert tussenbeelden voor vloeiendere bewegingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost jest włączony i generuje klatki pośrednie, aby zwiększyć płynność ruchu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Motion Boost está ativado e gera quadros intermediários para movimentos mais fluidos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost включён и создаёт промежуточные кадры для более плавного движения"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost เปิดอยู่และกำลังสร้างเฟรมกลางให้ภาพเคลื่อนไหวลื่นไหลขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost açık ve daha akıcı hareketler için ara kareler oluşturuyor"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost đang bật và tạo khung hình trung gian giúp chuyển động mượt mà hơn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost 已开启，正在生成中间帧以提升画面流畅度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost 已開啟，正在產生中間影格以提升畫面流暢度"
          }
        }
      }
    },
    "chrome.memc.tooltip.displayRefresh": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost kann nicht aktiviert werden, da die Bildwiederholrate des Displays für die angestrebte erhöhte Bildrate zu niedrig ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost is unavailable because the display’s refresh rate is too low for the enhanced target frame rate"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede activar Motion Boost porque la frecuencia de actualización de la pantalla es demasiado baja para la tasa de fotogramas objetivo mejorada"
          }
        },
        "fr": {
