        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์ Dolby Vision นี้ไม่มีเลเยอร์พื้นฐานที่เข้ากันได้ซึ่งผ่านการตรวจสอบแล้ว"
