    "defaultPlayer.prompt.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle von Khua unterstützten Video- und Audioformate – darunter MKV, MP4, WebM und MP3 – werden standardmäßig mit dieser App geöffnet. Wähle „Formate anpassen…“, um nur bestimmte Formate auszuwählen. Dies kann jederzeit im App-Menü geändert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All video and audio formats Khua supports — including MKV, MP4, WebM and MP3 — will open in this app by default. Choose “Customize Formats…” to pick only some. You can change this anytime from the app menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los formatos de vídeo y audio compatibles con Khua, incluidos MKV, MP4, WebM y MP3, se abrirán de forma predeterminada con esta app. Elige «Personalizar formatos…» para seleccionar solo algunos. Puedes cambiarlo en cualquier momento desde el menú de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les formats vidéo et audio pris en charge par Khua, notamment MKV, MP4, WebM et MP3, s’ouvriront par défaut avec cette app. Choisissez « Personnaliser les formats… » pour n’en sélectionner que certains. Vous pourrez modifier ce réglage à tout moment depuis le menu de l’app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua format video dan audio yang didukung Khua, termasuk MKV, MP4, WebM, dan MP3, akan dibuka dengan app ini secara default. Pilih “Sesuaikan Format…” untuk memilih format tertentu saja. Anda dapat mengubahnya kapan saja dari menu app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i formati video e audio supportati da Khua, inclusi MKV, MP4, WebM e MP3, verranno aperti per impostazione predefinita con questa app. Scegli “Personalizza formati…” per selezionarne solo alcuni. Puoi cambiare questa impostazione in qualsiasi momento dal menu dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Khua が対応するすべてのビデオおよびオーディオフォーマット（MKV、MP4、WebM、MP3 など）が、デフォルトでこのアプリで開くようになります。一部だけを選ぶには「フォーマットをカスタマイズ…」を選択してください。この設定はアプリメニューからいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MKV, MP4, WebM, MP3를 비롯해 Khua가 지원하는 모든 비디오 및 오디오 포맷이 기본적으로 이 앱에서 열립니다. 일부 포맷만 선택하려면 ‘포맷 사용자화…’를 선택하십시오. 이 설정은 앱 메뉴에서 언제든지 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle video- en audiobestandsindelingen die Khua ondersteunt, waaronder MKV, MP4, WebM en MP3, worden standaard met deze app geopend. Kies ‘Bestandsindelingen aanpassen…’ om er slechts enkele te selecteren. Je kunt dit op elk moment wijzigen via het appmenu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie formaty wideo i audio obsługiwane przez Khua, w tym MKV, MP4, WebM i MP3, będą domyślnie otwierane w tej aplikacji. Wybierz „Dostosuj formaty…”, aby zaznaczyć tylko niektóre. Ustawienie można w każdej chwili zmienić w menu aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os formatos de vídeo e áudio compatíveis com o Khua, incluindo MKV, MP4, WebM e MP3, serão abertos por padrão com este app. Escolha “Personalizar formatos…” para selecionar apenas alguns. Você pode alterar essa opção a qualquer momento no menu do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все видео- и аудиоформаты, поддерживаемые Khua, включая MKV, MP4, WebM и MP3, будут по умолчанию открываться в этом приложении. Выберите «Настроить форматы…», чтобы отметить только некоторые форматы. Этот параметр можно изменить в любое время в меню приложения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปแบบวิดีโอและเสียงทั้งหมดที่ Khua รองรับ รวมถึง MKV, MP4, WebM และ MP3 จะเปิดด้วยแอปนี้โดยค่าเริ่มต้น เลือก “กำหนดรูปแบบเอง…” หากต้องการเลือกเพียงบางรูปแบบ คุณเปลี่ยนการตั้งค่านี้ได้ทุกเมื่อจากเมนูแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MKV, MP4, WebM ve MP3 dahil Khua tarafından desteklenen tüm video ve ses biçimleri varsayılan olarak bu uygulamada açılacak. Yalnızca bazılarını seçmek için “Biçimleri Özelleştir…” seçeneğini kullanın. Bunu uygulama menüsünden istediğiniz zaman değiştirebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả định dạng video và âm thanh mà Khua hỗ trợ, bao gồm MKV, MP4, WebM và MP3, sẽ mặc định mở bằng ứng dụng này. Chọn “Tùy chỉnh định dạng…” để chỉ chọn một số định dạng. Bạn có thể thay đổi thiết lập này bất cứ lúc nào trong menu ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Khua 支持的视频与音频格式（MKV、MP4、WebM、MP3 等）都将默认用本 App 打开。想只关联部分格式，请选「自定义格式…」。之后随时可在 App 菜单中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Khua 支援的所有視訊與音訊格式（包括 MKV、MP4、WebM 和 MP3）都會預設以此 App 開啟。若只想關聯部分格式，請選擇「自訂格式…」。之後可隨時從 App 選單更改。"
          }
        }
      }
    },
