          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video quét xen kẽ cần khử xen kẽ trước, đã bỏ qua"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隔行视频需先去隔行，已旁路"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
