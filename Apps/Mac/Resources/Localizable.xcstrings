      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Sprache wird nach einem Neustart von Khua wirksam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new language takes effect after Khua restarts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo idioma se aplicará al reiniciar Khua."
          }
        },
