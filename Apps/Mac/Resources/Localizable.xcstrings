    "captions.save.retained": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Untertitel sind noch im Arbeitsspeicher verfügbar. Erneut speichern oder einen anderen Dateinamen wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subtitle results are still available in memory. Retry saving or choose another filename."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subtítulos siguen disponibles en memoria. Vuelve a intentar guardarlos o elige otro nombre de archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sous-titres sont toujours disponibles en mémoire. Réessayez de les enregistrer ou choisissez un autre nom de fichier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil subtitle masih tersedia di memori. Coba simpan lagi atau pilih nama file lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I sottotitoli sono ancora disponibili in memoria. Riprova a salvarli o scegli un altro nome per il file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕の結果はメモリに保持されています。保存を再試行するか、別のファイル名を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자막 결과가 메모리에 보관되어 있습니다. 저장을 다시 시도하거나 다른 파일 이름을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ondertitels zijn nog beschikbaar in het geheugen. Probeer opnieuw op te slaan of kies een andere bestandsnaam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyniki nadal znajdują się w pamięci. Ponów zapis lub wybierz inną nazwę pliku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As legendas ainda estão disponíveis na memória. Tente salvar novamente ou escolha outro nome de arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты создания субтитров ещё находятся в памяти. Повторите сохранение или выберите другое имя файла."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลลัพธ์คำบรรยายยังอยู่ในหน่วยความจำ โปรดลองบันทึกอีกครั้งหรือเลือกชื่อไฟล์อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazı sonuçları hâlâ bellekte. Kaydetmeyi yeniden deneyin veya başka bir dosya adı seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả phụ đề vẫn còn trong bộ nhớ. Hãy thử lưu lại hoặc chọn tên tệp khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕结果仍保留在内存中，可重新保存或选择其他文件名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕結果仍保留在記憶體中。您可以重試儲存，或選擇其他檔名。"
          }
        }
      }
    },
    "captions.save.superseded": {
      "localizations": {
        "de": {
          "stringUnit": {
