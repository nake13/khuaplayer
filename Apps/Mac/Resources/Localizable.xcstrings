    "captions.welcome.waitingForPlayback": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Untertitelauftrag für %@ pausiert, wartet auf stabile Wiedergabe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subtitle task for %@ is paused to prioritize playback"
          }
        },
        "es": {
