          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten profil Dolby Vision nie ma zweryfikowanej zgodnej warstwy bazowej"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil Dolby Vision não tem camada de base compatível verificada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого профиля Dolby Vision нет проверенного совместимого базового слоя"
