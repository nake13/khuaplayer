        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Motion Boost está se preparando para melhorar a fluidez dos movimentos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost готовится к повышению плавности движения"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost กำลังเตรียมพร้อมเพื่อเพิ่มความลื่นไหลของภาพเคลื่อนไหว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost, hareket akıcılığını artırmak için hazırlanıyor"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost đang chuẩn bị để tăng độ mượt của chuyển động"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost 正在准备，完成后将增强画面流畅度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost 正在準備，完成後將增強畫面流暢度"
          }
        }
      }
    },
    "chrome.memc.tooltip.partial": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost ist aktiviert, verbessert die Bewegungsdarstellung aber aufgrund von Faktoren wie der Geräteleistung nur teilweise"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost is on, but smoothness is only partially enhanced due to factors such as device performance"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost está activado, pero la fluidez solo mejora parcialmente debido a factores como el rendimiento del dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost est activé, mais la fluidité n’est que partiellement améliorée en raison de facteurs tels que les performances de l’appareil"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost aktif, tetapi kelancaran hanya ditingkatkan sebagian karena faktor seperti kinerja perangkat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost è attivo, ma la fluidità è migliorata solo in parte a causa di fattori come le prestazioni del dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boostはオンですが、デバイスの性能などの要因により、映像の一部のみが滑らかになっています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost가 켜져 있지만 기기 성능 등의 이유로 일부 화면만 더 부드럽게 표시됩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost is ingeschakeld, maar bewegingen worden slechts gedeeltelijk vloeiender weergegeven door factoren zoals de prestaties van het apparaat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost jest włączony, ale płynność jest poprawiana tylko częściowo z powodu czynników takich jak wydajność urządzenia"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Motion Boost está ativado, mas a fluidez é melhorada apenas parcialmente devido a fatores como o desempenho do dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost включён, но плавность повышается лишь частично из-за таких факторов, как производительность устройства"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost เปิดอยู่ แต่เพิ่มความลื่นไหลได้เพียงบางส่วนเนื่องจากปัจจัยต่าง ๆ เช่น ประสิทธิภาพของอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost açık ancak aygıt performansı gibi etkenler nedeniyle akıcılık yalnızca kısmen artırılıyor"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost đang bật nhưng độ mượt chỉ được cải thiện một phần do các yếu tố như hiệu năng thiết bị"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost 已开启，因设备性能等原因，仅部分画面获得流畅度增强"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost 已開啟，因裝置效能等原因，僅部分畫面獲得流暢度增強"
          }
        }
      }
    },
    "chrome.memc.tooltip.resolutionLimit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost kann nicht aktiviert werden, da derzeit nur Videos bis einschließlich 4K unterstützt werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost is unavailable because only videos up to 4K are currently supported"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede activar Motion Boost porque actualmente solo se admiten vídeos de hasta 4K"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost ne peut pas être activé, car seules les vidéos jusqu’à la 4K sont actuellement prises en charge"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost tidak dapat diaktifkan karena saat ini hanya mendukung video beresolusi hingga 4K"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile attivare Motion Boost perché al momento sono supportati solo video fino a 4K"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boostは現在4K以下の解像度の動画にのみ対応しているため、オンにできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost는 현재 4K 이하 해상도의 비디오만 지원하므로 켤 수 없습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost kan niet worden ingeschakeld omdat momenteel alleen video’s tot en met 4K worden ondersteund"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można włączyć Motion Boost, ponieważ obecnie obsługiwane są tylko filmy o rozdzielczości do 4K"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ativar o Motion Boost porque, no momento, apenas vídeos com resolução de até 4K são compatíveis"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost нельзя включить, поскольку сейчас поддерживаются только видео с разрешением до 4K включительно"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปิด Motion Boost ได้ เนื่องจากขณะนี้รองรับเฉพาะวิดีโอที่มีความละเอียดไม่เกิน 4K"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda yalnızca 4K ve altı çözünürlükteki videolar desteklendiği için Motion Boost açılamıyor"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể bật Motion Boost vì hiện chỉ hỗ trợ video có độ phân giải tối đa 4K"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost 无法开启，当前仅支持 4K 及以下分辨率的视频"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Boost 無法開啟，目前僅支援 4K 及以下解析度的影片"
          }
        }
      }
    },
