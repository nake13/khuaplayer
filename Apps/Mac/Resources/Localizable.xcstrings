            "state": "translated",
            "value": "Je kunt dit op elk moment instellen via ‘Stel in als standaardspeler…’ in het appmenu"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz to ustawić w dowolnym momencie przez „Ustaw jako domyślny odtwarzacz…” w menu aplikacji"
          }
        },
        "pt": {
          "stringUnit": {
