        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の字幕を保存中です。終了すると保存が中断される場合があります。「キャンセル」を選ぶと引き続き待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 자막을 저장 중입니다. 종료하면 저장이 중단될 수 있습니다. 계속 기다리려면 취소를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ondertitels voor ‘%@’ worden opgeslagen. Afsluiten kan het opslaan onderbreken. Kies Annuleer om te blijven wachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa zapisywanie napisów do „%@”. Zakończenie aplikacji może przerwać zapis. Wybierz Anuluj, aby czekać dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As legendas de “%@” estão sendo salvas. Encerrar pode interromper o salvamento. Escolha Cancelar para continuar aguardando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Субтитры для «%@» сохраняются. Выход может прервать сохранение. Выберите «Отмена», чтобы продолжить ожидание."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังบันทึกคำบรรยายสำหรับ “%@” การออกอาจขัดจังหวะการบันทึก เลือกยกเลิกเพื่อรอต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” için altyazılar kaydediliyor. Çıkmak kaydetmeyi yarıda kesebilir. Beklemeye devam etmek için İptal'i seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang lưu phụ đề cho “%@”. Thoát có thể làm gián đoạn việc lưu. Chọn Hủy để tiếp tục chờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存「%@」的字幕。退出可能中断保存；选择取消可继续等待。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在儲存「%@」的字幕。結束可能會中斷儲存；請選擇「取消」以繼續等待。"
          }
        }
      }
    },
