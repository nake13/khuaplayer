    "defaultPlayer.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, welche Medienformate standardmäßig mit dieser App geöffnet werden sollen. Formate, die die integrierten Player des Systems bereits gut wiedergeben (z. B. MP4 und MP3), sind standardmäßig nicht ausgewählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which media formats should open in this app by default. Formats the built-in system players already handle well (such as MP4 and MP3) are unchecked by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué formatos multimedia se abrirán con esta app de forma predeterminada. Los formatos que los reproductores integrados del sistema ya reproducen bien (como MP4 y MP3) están desmarcados por omisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les formats multimédias à ouvrir par défaut avec cette app. Les formats déjà bien pris en charge par les lecteurs intégrés du système (comme MP4 et MP3) sont décochés par défaut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih format media yang akan dibuka dengan app ini secara default. Format yang sudah diputar dengan baik oleh pemutar bawaan sistem (seperti MP4 dan MP3) tidak dicentang secara default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali formati multimediali aprire con questa app per impostazione predefinita. I formati che i lettori integrati del sistema riproducono già bene (come MP4 e MP3) non sono selezionati di default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このAppでデフォルトで開くメディアフォーマットを選択してください。システム標準のプレーヤーで十分に再生できるフォーマット（MP4、MP3など）は、デフォルトではオフになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱으로 기본으로 열 미디어 포맷을 선택하십시오. 시스템 기본 플레이어로 이미 잘 재생되는 포맷(MP4, MP3 등)은 기본적으로 선택되어 있지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies welke mediaformaten standaard met deze app worden geopend. Formaten die de ingebouwde spelers van het systeem al goed afspelen (zoals MP4 en MP3), zijn standaard niet aangevinkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz formaty multimediów, które mają być domyślnie otwierane w tej aplikacji. Formaty dobrze obsługiwane przez systemowe odtwarzacze (np. MP4 i MP3) są domyślnie odznaczone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais formatos de mídia serão abertos neste app por padrão. Os formatos que os reprodutores nativos do sistema já reproduzem bem (como MP4 e MP3) vêm desmarcados por padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите форматы мультимедиа, которые по умолчанию будут открываться в этом приложении. Форматы, которые встроенные плееры системы уже хорошо воспроизводят (например, MP4 и MP3), по умолчанию не отмечены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกฟอร์แมตสื่อที่ต้องการให้เปิดด้วยแอปนี้ตามค่าเริ่มต้น ฟอร์แมตที่เพลเยอร์ในตัวของระบบเล่นได้ดีอยู่แล้ว (เช่น MP4 และ MP3) จะไม่ถูกเลือกไว้ตามค่าเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamayla varsayılan olarak açılacak ortam formatlarını seçin. Sistemin yerleşik oynatıcılarının zaten iyi oynattığı formatlar (MP4 ve MP3 gibi) varsayılan olarak işaretli değildir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn các định dạng phương tiện sẽ mở bằng ứng dụng này theo mặc định. Các định dạng mà trình phát có sẵn của hệ thống đã phát tốt (như MP4 và MP3) sẽ không được chọn sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要默认用本 App 打开的媒体格式。系统自带播放器已能良好播放的格式（MP4、MP3 等）默认未勾选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要預設以本 App 開啟的媒體格式。系統內建播放器已能良好播放的格式（MP4、MP3 等）預設不勾選。"
          }
        }
      }
    },
