    "access.folder.captionsMessage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzeugte Untertitel werden neben dem Video gesichert. Erlaube den Zugriff auf diesen Ordner, dann wirst du hier nicht erneut gefragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generated subtitles are saved next to the video. Allow access to this folder and you won’t be asked again when generating subtitles here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subtítulos generados se guardan junto al vídeo. Permite el acceso a esta carpeta y no se te volverá a preguntar aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sous-titres générés sont enregistrés à côté de la vidéo. Autorisez l’accès à ce dossier pour ne plus avoir à confirmer ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitel yang dibuat disimpan di sebelah video. Izinkan akses ke folder ini agar tidak ditanya lagi saat membuat subtitel di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I sottotitoli generati vengono salvati accanto al video. Consenti l’accesso a questa cartella e non ti verrà più chiesto qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成した字幕はビデオと同じ場所に保存されます。このフォルダへのアクセスを許可すると、以後ここで字幕を生成するときに確認されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성된 자막은 동영상 옆에 저장됩니다. 이 폴더에 대한 접근을 허용하면 이후 여기에서 자막을 생성할 때 다시 묻지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegenereerde ondertitels worden naast de video bewaard. Geef toegang tot deze map, dan wordt het hier niet opnieuw gevraagd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygenerowane napisy są zapisywane obok wideo. Zezwól na dostęp do tego folderu, a pytanie nie pojawi się tu ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As legendas geradas são salvas ao lado do vídeo. Permita o acesso a esta pasta e isso não será perguntado novamente aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Созданные субтитры сохраняются рядом с видео. Разрешите доступ к этой папке, и здесь больше не будет запросов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำบรรยายที่สร้างจะถูกบันทึกไว้ข้างวิดีโอ อนุญาตให้เข้าถึงโฟลเดอร์นี้แล้วจะไม่ถามอีกเมื่อสร้างคำบรรยายที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturulan altyazılar videonun yanına kaydedilir. Bu klasöre erişim izni verin; burada bir daha sorulmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ đề được tạo sẽ lưu cạnh video. Hãy cho phép truy cập thư mục này để không bị hỏi lại khi tạo phụ đề tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成的字幕会保存在视频旁边。允许访问这个文件夹后，以后在这里生成字幕不再询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生的字幕會儲存在影片旁邊。允許存取這個資料夾後，之後在這裡產生字幕將不再詢問。"
          }
        }
      }
    },
    "access.folder.playlistMessage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf diesen Ordner, um die nächste Folge abzuspielen und Untertitel daraus automatisch zu laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to this folder to play the next episode and load subtitles from it automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a esta carpeta para reproducir el siguiente episodio y cargar sus subtítulos automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à ce dossier pour lire l’épisode suivant et charger automatiquement ses sous-titres."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses ke folder ini untuk memutar episode berikutnya dan memuat subtitel secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso a questa cartella per riprodurre l’episodio successivo e caricarne automaticamente i sottotitoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダへのアクセスを許可すると、同じフォルダ内の次のエピソードの再生や字幕の自動読み込みができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에 대한 접근을 허용하면 같은 폴더의 다음 에피소드를 재생하고 자막을 자동으로 불러올 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef toegang tot deze map om de volgende aflevering af te spelen en ondertitels automatisch te laden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do tego folderu, aby odtwarzać następny odcinek i automatycznie wczytywać napisy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso a esta pasta para reproduzir o próximo episódio e carregar legendas automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к этой папке, чтобы воспроизводить следующую серию и автоматически загружать субтитры."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้เข้าถึงโฟลเดอร์นี้เพื่อเล่นตอนถัดไปและโหลดคำบรรยายโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki bölümü oynatmak ve altyazıları otomatik yüklemek için bu klasöre erişim izni verin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập thư mục này để phát tập tiếp theo và tự động tải phụ đề."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问这个文件夹后，可以播放同一文件夹里的下一集，并自动加载字幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許存取這個資料夾後，即可播放同一資料夾中的下一集，並自動載入字幕。"
          }
        }
      }
    },
    "access.recent.reauthorizeFmt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „%@“ erneut aus, um den Zugriff wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select “%@” again to restore access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a seleccionar «%@» para restaurar el acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez à nouveau « %@ » pour rétablir l’accès."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih “%@” lagi untuk memulihkan akses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona di nuovo “%@” per ripristinare l’accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを復元するには「%@」をもう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 권한을 복원하려면 ‘%@’을(를) 다시 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer ‘%@’ opnieuw om de toegang te herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz ponownie „%@”, aby przywrócić dostęp."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione “%@” novamente para restaurar o acesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «%@» ещё раз, чтобы восстановить доступ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก “%@” อีกครั้งเพื่อกู้คืนการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişimi geri yüklemek için “%@” öğesini yeniden seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn lại “%@” để khôi phục quyền truy cập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请再选择一次「%@」以恢复访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請再選擇一次「%@」以恢復存取。"
          }
        }
      }
    },
    "access.folder.wrongFolderFmt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgewählte Ordner enthält dieses Video nicht. Wähle den Ordner „%@“ oder einen übergeordneten Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected folder doesn’t contain this video. Choose the “%@” folder or a folder that contains it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta seleccionada no contiene este vídeo. Elige la carpeta «%@» o una carpeta que la contenga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier sélectionné ne contient pas cette vidéo. Choisissez le dossier « %@ » ou un dossier qui le contient."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder yang dipilih tidak berisi video ini. Pilih folder “%@” atau folder yang memuatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella selezionata non contiene questo video. Scegli la cartella “%@” o una cartella che la contiene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフォルダにはこのビデオが含まれていません。「%@」フォルダ、またはその上位のフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 폴더에 이 동영상이 없습니다. ‘%@’ 폴더 또는 그 상위 폴더를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gekozen map bevat deze video niet. Kies de map ‘%@’ of een map waarin deze staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany folder nie zawiera tego wideo. Wybierz folder „%@” lub folder nadrzędny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta selecionada não contém este vídeo. Escolha a pasta “%@” ou uma pasta que a contenha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная папка не содержит это видео. Выберите папку «%@» или папку, в которой она находится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์ที่เลือกไม่มีวิดีโอนี้ โปรดเลือกโฟลเดอร์ “%@” หรือโฟลเดอร์ที่อยู่เหนือขึ้นไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen klasör bu videoyu içermiyor. “%@” klasörünü veya onu içeren bir klasörü seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục đã chọn không chứa video này. Hãy chọn thư mục “%@” hoặc thư mục chứa nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件夹不包含这个视频。请选择「%@」文件夹或它的上级文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選資料夾不包含這部影片。請選擇「%@」資料夾或其上層資料夾。"
          }
        }
      }
    },
