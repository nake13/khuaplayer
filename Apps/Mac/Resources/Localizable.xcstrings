        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโออินเทอร์เลซต้องผ่านการดีอินเทอร์เลซก่อน จึงข้ามไป"
          }
        },
        "tr": {
          "stringUnit": {
