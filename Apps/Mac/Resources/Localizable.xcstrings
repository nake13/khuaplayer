            "value": "El destino de traducción seleccionado no es compatible con este idioma de audio. Se ha cambiado a solo transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue cible choisie n’est pas prise en charge pour cette langue audio. Passage à la transcription uniquement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahasa audio ini tidak mendukung bahasa tujuan yang dipilih. Beralih ke transkripsi saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua di traduzione scelta non è supportata per questa lingua audio. È stata attivata la sola trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この音声の言語から選択した言語への翻訳には対応していません。文字起こしのみに切り替えました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 오디오 언어는 선택한 언어로 번역할 수 없습니다. 받아쓰기만 하도록 전환했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gekozen doeltaal wordt niet ondersteund voor deze audiotaal. Overgeschakeld naar alleen transcriberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany język docelowy nie jest obsługiwany dla tego języka dźwięku. Przełączono na samą transkrypcję."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma de destino selecionado não é compatível com este idioma de áudio. Alterado para somente transcrição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод с этого языка аудио на выбранный язык недоступен. Включена только транскрипция."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาษาของเสียงนี้ไม่รองรับการแปลเป็นภาษาที่เลือก เปลี่ยนเป็นถอดเสียงเท่านั้นแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ses dili için seçilen hedef dile çeviri desteklenmiyor. Yalnızca yazıya dökme moduna geçildi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ âm thanh này không hỗ trợ dịch sang ngôn ngữ đã chọn. Đã chuyển sang chỉ chuyển giọng nói thành văn bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该音频语言不支持所选翻译目标，已改为只转录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此音訊語言不支援所選的翻譯目標，已改為僅轉錄。"
          }
        }
      }
    },
