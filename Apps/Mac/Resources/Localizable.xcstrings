        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightness Boost가 켜져 있으며 디스플레이 성능에 맞춰 영상 밝기를 높입니다"
          }
        },
        "nl": {
          "stringUnit": {
