    "captions.save.busy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Untertitelauftrag läuft, wartet oder wird gespeichert. Bitte nach dessen Abschluss erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another subtitle task is running, queued, or saving. Try again when it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otra tarea de subtítulos en ejecución, en cola o guardándose. Inténtalo de nuevo cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre tâche de sous-titrage est en cours, en attente ou en cours d’enregistrement. Réessayez lorsqu’elle sera terminée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas subtitle lain sedang berjalan, mengantre, atau menyimpan. Coba lagi setelah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra attività dei sottotitoli è in corso, in coda o in fase di salvataggio. Riprova quando sarà terminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の字幕タスクが実行中、待機中、または保存中です。完了してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 자막 작업이 실행 중이거나 대기 또는 저장 중입니다. 완료된 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere ondertiteltaak is actief, staat in de wachtrij of wordt opgeslagen. Probeer het opnieuw wanneer die klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne zadanie napisów trwa, jest w kolejce lub zapisuje wyniki. Spróbuj ponownie po jego ukończeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra tarefa de legendas está em execução, na fila ou salvando. Tente novamente quando ela terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другая задача создания субтитров выполняется, находится в очереди или сохраняет результат. Повторите попытку после её завершения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานคำบรรยายอื่นกำลังทำงาน อยู่ในคิว หรือกำลังบันทึก โปรดลองอีกครั้งหลังจากงานนั้นเสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir altyazı görevi çalışıyor, kuyrukta veya kaydediliyor. Tamamlandığında yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tác vụ phụ đề khác đang chạy, chờ trong hàng đợi hoặc đang lưu. Hãy thử lại khi tác vụ đó hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个字幕任务正在运行、排队或保存，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個字幕工作正在執行、排隊或儲存。請待其完成後再試。"
          }
        }
      }
    },
    "captions.save.diskFull": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Datenträger ist voll. Speicherplatz freigeben oder auf einem anderen Datenträger speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk is full. Free some space or save to another disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco está lleno. Libera espacio o guarda los subtítulos en otro disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est plein. Libérez de l’espace ou enregistrez les sous-titres sur un autre disque."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk penuh. Kosongkan sebagian ruang atau simpan ke disk lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco è pieno. Libera spazio o salva su un altro disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの空き容量が不足しています。空き容量を増やすか、別のディスクに保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 공간이 부족합니다. 공간을 확보하거나 다른 디스크에 저장하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijf is vol. Maak ruimte vrij of sla de ondertitels op op een andere schijf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk jest pełny. Zwolnij miejsce lub zapisz napisy na innym dysku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco está cheio. Libere espaço ou salve em outro disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск заполнен. Освободите место или сохраните на другой диск."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดิสก์เต็ม โปรดเพิ่มพื้นที่ว่างหรือบันทึกไปยังดิสก์อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk dolu. Yer açın veya başka bir diske kaydedin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa đã đầy. Hãy giải phóng dung lượng hoặc lưu vào ổ đĩa khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘空间不足。请释放空间或另存到其他磁盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "磁碟空間不足。請釋放空間或另存至其他磁碟。"
          }
        }
      }
    },
    "captions.save.permission": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ziel fehlen Schreibrechte. Bitte an einem Ort mit Schreibzugriff speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination is not writable. Save to a location where you have write permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede escribir en el destino. Guarda los subtítulos en una ubicación donde tengas permiso de escritura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas l’autorisation d’écrire à cet emplacement. Enregistrez les sous-titres dans un emplacement accessible en écriture."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tujuan tidak dapat ditulisi. Simpan ke lokasi yang mengizinkan Anda menulis file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai il permesso di scrivere nella destinazione. Salva in una posizione in cui disponi dei permessi di scrittura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存先に書き込めません。書き込み権限のある場所に保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 위치에 쓰기 권한이 없습니다. 쓰기 권한이 있는 위치에 저장하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt geen schrijfrechten voor het doel. Sla de ondertitels op op een locatie waar je wel schrijfrechten hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak uprawnień do zapisu w miejscu docelowym. Zapisz napisy w miejscu, w którym masz uprawnienia do zapisu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não tem permissão para gravar no destino. Salve em um local onde tenha permissão de gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет прав на запись в указанное место. Выберите папку, в которую у вас есть право записи."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเขียนไปยังปลายทางได้ โปรดบันทึกไปยังตำแหน่งที่คุณมีสิทธิ์เขียน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefe yazılamıyor. Yazma izninizin olduğu bir konuma kaydedin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể ghi vào đích. Hãy lưu vào vị trí mà bạn có quyền ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有写入权限。请另存到可写入的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有寫入權限。請另存至可寫入的位置。"
          }
        }
      }
    },
