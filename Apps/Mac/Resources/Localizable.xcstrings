    "welcome.setDefault.dismissed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann jederzeit über „Als Standard-Player festlegen …“ im App-Menü eingestellt werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can set this anytime from “Set as Default Player…” in the app menu"
          }
        },
        "es": {
