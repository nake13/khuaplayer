            "state": "translated",
            "value": "La tarea de subtítulos para %@ está en pausa, esperando a que se estabilice la reproducción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sous-titrage de %@ est en pause, en attente d’une lecture stable"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas subtitle untuk %@ dijeda agar pemutaran tetap lancar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attività dei sottotitoli per %@ è in pausa, in attesa che la riproduzione si stabilizzi"
          }
        },
        "ja": {
          "stringUnit": {
