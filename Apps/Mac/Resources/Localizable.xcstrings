        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình Dolby Vision này không có lớp cơ sở tương thích đã được xác minh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
