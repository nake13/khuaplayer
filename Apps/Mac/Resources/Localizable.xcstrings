    "clearHistory.confirm.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Wiedergabedaten werden gelöscht: Fortsetzungspositionen, zuletzt geöffnete Dateien und der gemerkte Ordner des Öffnen-Dialogs. Diese Aktion kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes all playback records: resume positions, recent files, and the remembered open-panel folder. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los registros de reproducción: posiciones de reanudación, archivos recientes y la carpeta recordada del panel de apertura. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les enregistrements de lecture seront supprimés : positions de reprise, fichiers récents et dossier mémorisé du dialogue d’ouverture. Cette action est irréversible."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua catatan pemutaran akan dihapus: posisi lanjut menonton, daftar file yang baru dibuka, dan folder yang diingat. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati tutti i dati di riproduzione: posizioni di ripresa, file recenti e cartella di apertura memorizzata. L'operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続きから再生の位置、最近開いたファイルの一覧、フォルダの記憶を含むすべての再生記録を削除します。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 재생 기록이 삭제됩니다: 이어보기 위치, 최근 파일 목록, 기억된 폴더. 이 동작은 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle afspeelgegevens verwijderd: hervattingsposities, recente bestanden en de onthouden map van het openvenster. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie wszystkich danych odtwarzania: pozycji wznawiania, listy ostatnio otwieranych plików i zapamiętanego folderu otwierania. Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os registros de reprodução serão removidos: posições de retomada, arquivos recentes e a pasta memorizada do painel de abertura. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут удалены все данные о воспроизведении: позиции возобновления, список недавних файлов и запомненная папка открытия. Это действие нельзя отменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะลบประวัติการเล่นทั้งหมด ได้แก่ ตำแหน่งเล่นต่อ รายการไฟล์ล่าสุด และโฟลเดอร์ที่จำไว้ในหน้าต่างเปิดไฟล์ การกระทำนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm oynatma kayıtları silinecek: devam etme konumları, son açılan dosyalar ve anımsanan açma klasörü. Bu işlem geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa toàn bộ lịch sử phát: vị trí phát tiếp, danh sách tệp mở gần đây và thư mục đã ghi nhớ trong hộp thoại mở tệp. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除所有播放记录：续播位置、最近打开的文件列表与目录记忆。此操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除所有播放記錄：續播位置、最近開啟的檔案清單與檔案夾記憶。此操作無法復原。"
          }
        }
      }
    },
