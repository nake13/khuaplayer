    "error.openFailed.zeroHead": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei beginnt mit einem noch nicht geschriebenen leeren Bereich; der Download ist möglicherweise nicht abgeschlossen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file begins with unwritten blank space; it may not have finished downloading"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo empieza con un espacio en blanco sin escribir; puede que la descarga no haya terminado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier commence par une zone vide non écrite ; le téléchargement n’est peut-être pas terminé"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File diawali dengan area kosong yang belum ditulis; unduhan mungkin belum selesai"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file inizia con un’area vuota non ancora scritta; il download potrebbe non essere completo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの先頭が未書き込みの空白領域です。ダウンロードが完了していない可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 아직 기록되지 않은 빈 영역으로 시작합니다. 다운로드가 끝나지 않았을 수 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand begint met een nog niet geschreven leeg gebied; de download is mogelijk niet voltooid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zaczyna się od niezapisanego pustego obszaru; pobieranie mogło nie zostać zakończone"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo começa com um espaço em branco ainda não gravado; o download pode não ter terminado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл начинается с незаписанной пустой области; возможно, загрузка не завершена"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์เริ่มต้นด้วยพื้นที่ว่างที่ยังไม่ได้เขียน การดาวน์โหลดอาจยังไม่เสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya henüz yazılmamış boş bir alanla başlıyor; indirme tamamlanmamış olabilir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp bắt đầu bằng một vùng trống chưa được ghi; quá trình tải xuống có thể chưa hoàn tất"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件开头是尚未写入的空白区，文件可能未下载完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案開頭是尚未寫入的空白區域，可能尚未下載完成"
          }
        }
      }
